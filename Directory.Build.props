<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Package metadata. Only the plugin is published; it imports build/PluginPackage.targets, which
    makes it packable.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>LANCommander</Authors>
    <Company>LANCommander</Company>
    <Copyright>Copyright (c) LANCommander</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LANCommander/LANCommander.Plugins.Sync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LANCommander/LANCommander.Plugins.Sync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Host packages packed from an unreleased LANCommander checkout into artifacts/packages are
    restorable without any further setup; see the README.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)artifacts\packages')">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)artifacts\packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
